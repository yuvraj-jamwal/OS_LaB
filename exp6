C Program to Consume a Specified Amount of Memory

#include <stdio.h>
#include <stdlib.h>

int main(int argc, char *argv[])
{
    if (argc != 2)
    {
        printf("Usage: ./memory MB\n");
        return 1;
    }

    int mb = atoi(argv[1]);

    if (mb <= 0 || mb > 1024)
    {
        printf("Enter memory between 1 and 1024 MB\n");
        return 1;
    }

    size_t size = (size_t)mb * 1024 * 1024;

    char *ptr = calloc(size, 1);

    if (ptr == NULL)
    {
        printf("Memory allocation failed\n");
        return 1;
    }

    // Touch one byte per memory page
    for (size_t i = 0; i < size; i += 4096)
    {
        ptr[i] = 1;
    }

    printf("Allocated approximately %d MB memory\n", mb);
    printf("Press Enter to release memory\n");

    getchar();

    free(ptr);

    printf("Memory released\n");

    return 0;
}
